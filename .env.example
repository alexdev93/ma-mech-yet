# Copy to .env.local and adjust. Never commit real values.
# Server-only: read through src/server/config/env.ts, never prefixed with NEXT_PUBLIC_.

# Base URL of the public demo API used by /examples/server
DEMO_API_URL=https://jsonplaceholder.typicode.com

# Neon (PostgreSQL) connection string. Use the pooled host and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Telegram OpenID Connect client, issued by @BotFather (Bot Settings > Login > OpenID Connect).
# The redirect URI must match the one registered in BotFather exactly.
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://your-public-host/auth/telegram/callback
TELEGRAM_OIDC_SCOPES=openid profile

# env-vault. Locally, `envvault login` once; `pnpm dev`, `pnpm start` and `pnpm db:migrate`
# then inject the vault's variables. On hosts like Vercel, set only ENV_VAULT_TOKEN (secret):
# src/instrumentation.ts loads the rest when the server starts. Already-set variables win.
ENV_VAULT_TOKEN=
ENV_VAULT_PROJECT=ma-mech-yet
ENV_VAULT_BRANCH=main
ENV_VAULT_CLIENT=
